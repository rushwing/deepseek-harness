# Imported unified patches contain meaningful blank context lines prefixed by
# one space; do not rewrite them as whitespace cleanup.
*.patch -whitespace

# Preserve the exact upstream license text, including its original whitespace.
asr-lab/app/src/main/assets/licenses/android-ndk-toolchain-NOTICE.txt -whitespace
asr-lab/app/src/main/assets/licenses/cpp-httplib-LICENSE -whitespace

# Keep Linux entry points executable from WSL even when core.autocrlf=true.
*.sh text eol=lf
gradlew text eol=lf

# Version/SHA guarded master bundles must retain their generated bytes on Windows.
android-shell/app/src/main/assets/patched/master-*.js -text -whitespace
